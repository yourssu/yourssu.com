# PostHog native capture is off unless this flag is explicitly true.
GATSBY_APP_POSTHOG_NATIVE_CAPTURE_ENABLED=false
GATSBY_APP_POSTHOG_DEPLOYMENT_ENV=development
GATSBY_APP_POSTHOG_KEY=
GATSBY_APP_POSTHOG_HOST=

# Production requires this second flag in addition to the native capture flag.
# Keep false until the coordinated SPR-125 GTM cutover.
GATSBY_APP_POSTHOG_PRODUCTION_CAPTURE_ENABLED=false
