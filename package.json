{
  "name": "yourssu",
  "description": "",
  "version": "1.0.0",
  "private": true,
  "author": "",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "check:recruiting-schedule": "pnpm exec tsx scripts/check-recruitingSchedule.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "deploy": "aws s3 website s3://yourssu.com --index-document index.html --error-document 404.html && aws s3 sync public s3://yourssu.com --delete && aws s3 cp public s3://yourssu.com --recursive --exclude '*' --include '*.html' --include 'page-data/*' --include 'sw.js' --cache-control 'public,max-age=0,must-revalidate' && aws s3 cp public s3://yourssu.com --recursive --exclude '*' --include '*.js' --include '*.css' --include 'static/*' --exclude 'sw.js' --cache-control 'public,max-age=31536000,immutable'"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "dotenv": "^17.4.2",
    "motion": "^13.1.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-google-tagmanager": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-source-sanity": "^7.9.2",
    "gatsby-transformer-sharp": "^5.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0"
  },
  "devDependencies": {
    "@types/gatsby-plugin-breakpoints": "^1.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "gatsby-plugin-breakpoints": "^1.3.11",
    "gatsby-plugin-postcss": "^6.16.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "tailwind-styled-components": "^2.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
